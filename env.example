# Loaded into the devcontainer via `--env-file` (see .devcontainer/devcontainer.json).
# IMPORTANT: this is parsed by Docker's --env-file, NOT by a shell:
#   - one KEY=VALUE per line; the value is the literal rest of the line
#   - NO quotes (they become part of the value), NO multi-line values, NO expansion
#   - no leading/trailing spaces around the value

# GIT_CREDENTIALS: single line, space-separated URL_PREFIX=TOKEN_ENV_VAR entries
# (see .devcontainer/post-create.sh). Slash-boundary, most-specific-wins.
GIT_CREDENTIALS=github.tools.sap=TOOLS_GITHUB_PAT
TOOLS_GITHUB_PAT=


ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
